                    <span>진행률: <span id="progress-text">0 / 0</span></span>
                </div>
            </div>
            
            <!-- Tabs -->
            <div class="flex space-x-8 border-b border-slate-200">
                <button onclick="switchTab('blank')" id="tab-blank" class="tab-btn tab-active pb-3 text-sm sm:text-base">🕳️ 빵꾸노트 (인출)</button>
                <button onclick="switchTab('mcq')" id="tab-mcq" class="tab-btn tab-inactive pb-3 text-sm sm:text-base">🎯 실전 객관식</button>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 overflow-y-auto bg-slate-50 pb-20">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            
            <!-- 탭 1: 빵꾸노트 -->
            <div id="view-blank" class="block">
                <!-- 카테고리 필터 -->
                <div class="flex items-center justify-between mb-4 gap-2">
