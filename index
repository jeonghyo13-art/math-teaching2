    <style>
        body { font-family: 'Pretendard', sans-serif; background-color: #f8fafc; }
        /* 탭 버튼 전환 효과 */
        .tab-btn { transition: all 0.2s ease-in-out; }
        .tab-active { border-bottom: 3px solid #4f46e5; color: #4f46e5; font-weight: 700; }
        .tab-inactive { color: #64748b; font-weight: 500; }
        
        /* 빈칸(Input) 디자인 */
        .blank-input {
            width: auto; min-width: 60px; max-width: 120px;
            text-align: center; font-weight: 600; color: #334155;
            border-bottom: 2px solid #94a3b8; background-color: transparent;
            padding: 0 4px; margin: 0 4px;
            transition: all 0.2s; outline: none;
        }
        .blank-input:focus { border-bottom-color: #4f46e5; background-color: #eef2ff; }
        .blank-input.correct { 
            color: #059669; border-bottom-color: #10b981; 
            background-color: #ecfdf5; pointer-events: none; 
        }
        .blank-input.wrong-revealed { 
            color: #e11d48; border-bottom-color: #f43f5e; 
            background-color: #fff1f2; pointer-events: none; 
            text-decoration: underline; text-decoration-color: #f43f5e;
        }

        /* 객관식 선지 효과 */
        .option-btn { transition: all 0.2s; }
        .option-btn:hover:not(:disabled) { background-color: #eef2ff; border-color: #a5b4fc; }
        .option-correct { background-color: #ecfdf5 !important; border-color: #10b981 !important; color: #059669 !important; font-weight: 700; }
        .option-wrong { background-color: #fff1f2 !important; border-color: #f43f5e !important; color: #e11d48 !important; font-weight: 700; }
        .option-disabled { opacity: 0.6; cursor: not-allowed; }

        /* 해설 박스 애니메이션 */
        .explanation-box {
            max-height: 0; opacity: 0; overflow: hidden;
            transition: max-height 0.4s ease, opacity 0.4s ease, margin 0.4s ease;
        }
        .explanation-box.show { max-height: 500px; opacity: 1; margin-top: 1rem; }
        
        /* 스크롤바 숨김 (카테고리 탭) */
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="text-slate-800 antialiased h-screen flex flex-col">

    <!-- Header & Progress -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
