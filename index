            {
                q: "동전 6개를 던질 때 'HHHTTT'보다 'HTTHHT'로 나타날 가능성이 더 높다고 생각하는 오류는 어떤 확률 판단 전략에 기인한 것인가?",
                options: ["정보의 이용가능성 전략", "조정과 고정 전략", "대표성 전략", "인과적 정보 전략"],
                ans: 2,
                exp: "대표성 전략(Representativeness)은 표본이 모집단의 특성(무작위성)을 그대로 반영할 것이라고 기대하여, 겉보기에 불규칙한 배열이 더 잘 나올 것이라 착각하는 현상입니다."
            },
            {
                q: "Sfard의 수학적 개념 발달 단계 중, 주어진 조작 과정을 전체적으로 인식하여 새로운 차원의 추상적 '대상'으로 파악하게 되는 최종 단계는?",
                options: ["행동(Action)", "내면화(Interiorization)", "압축(Condensation)", "실재화(Reification)"],
                ans: 3,
                exp: "Sfard의 조작적 개념 구성 단계는 내면화 -> 압축 -> 실재화(Reification)로 이루어집니다. 실재화 단계에서 비로소 개념이 독립적인 '대상'으로 인식됩니다."
            },
            {
                q: "수열의 극한 지도 시, 수열의 일반항이 진동하며 0에 수렴하는 교대수열을 보고 '진동하므로 극한값이 없다'고 잘못 판단하는 것은 Vinner의 이론 중 무엇에 기인한 오류인가?",
                options: ["개념 정의에 대한 불완전한 이해", "부적절한 개념 이미지에의 과도한 의존", "역사발생적 원리의 부재", "형식적 연역 능력의 부족"],
                ans: 1,
                exp: "학생이 '수열의 진동'이라는 강력한 심상(개념 이미지)에만 직관적으로 반응하여, 엄밀한 수학적 극한의 '개념 정의'를 간과하고 오답을 내는 상황입니다."
            },
            {
                q: "다음 중 탐색적 자료 분석(EDA)에서 극단적인 이상치(Outlier)가 존재할 때, 평균(Mean) 대신 중앙값(Median)을 선호하는 이유를 설명하는 용어는?",
                options: ["현시성", "수량화", "저항성", "탈배경화"],
                ans: 2,
                exp: "저항성(Resistance)은 자료 일부가 손상되거나 극단적인 값이 있어도 전체적인 자료 해석이 크게 흔들리지 않는 성질을 말합니다."
            }
        ];

        // ==========================================
        // 2. 상태 관리 및 유틸리티
        // ==========================================
        let currentTab = 'blank';
        let parsedBlanks = [];
        let blankStats = { total: 0, correct: 0, wrong: 0 };
        let mcqStats = { total: mcqData.length, correct: 0, wrong: 0 };
        
        let mcqState = mcqData.map(() => ({ answered: false, correct: false }));

        function getProgress() {
            if (currentTab === 'blank') return blankStats;
            return mcqStats;
        }

        function updateProgressUI() {
            const stats = getProgress();
            const total = stats.total || 1; 
            const correctPer = (stats.correct / total) * 100;
            const wrongPer = (stats.wrong / total) * 100;

            document.getElementById('progress-correct').style.width = `${correctPer}%`;
            document.getElementById('progress-wrong').style.width = `${wrongPer}%`;
            document.getElementById('count-correct').textContent = stats.correct;
            document.getElementById('count-wrong').textContent = stats.wrong;
            document.getElementById('progress-text').textContent = `${stats.correct + stats.wrong} / ${stats.total}`;
        }

        function switchTab(tabId) {
            currentTab = tabId;
            
            // Tab Styling
            document.getElementById('tab-blank').className = tabId === 'blank' ? 'tab-btn tab-active pb-3 text-sm sm:text-base' : 'tab-btn tab-inactive pb-3 text-sm sm:text-base';
            document.getElementById('tab-mcq').className = tabId === 'mcq' ? 'tab-btn tab-active pb-3 text-sm sm:text-base' : 'tab-btn tab-inactive pb-3 text-sm sm:text-base';
            
            // View Toggling
            document.getElementById('view-blank').classList.toggle('hidden', tabId !== 'blank');
            document.getElementById('view-blank').classList.toggle('block', tabId === 'blank');
            document.getElementById('view-mcq').classList.toggle('hidden', tabId !== 'mcq');
            document.getElementById('view-mcq').classList.toggle('block', tabId === 'mcq');

            updateProgressUI();
        }

        // ==========================================
        // 3. 빵꾸노트 (빈칸) 로직
        // ==========================================
        let activeCategory = '전체';
        
        function initBlanks() {
            // 카테고리 추출
            const categories = ['전체', ...new Set(blankData.map(d => d.category))];
            const filterContainer = document.getElementById('category-filters');
            filterContainer.innerHTML = categories.map(cat => 
                `<button onclick="filterBlanks('${cat}')" id="cat-${cat}" class="px-4 py-1.5 rounded-full text-sm font-semibold whitespace-nowrap transition-colors ${cat === '전체' ? 'bg-indigo-600 text-white' : 'bg-white border border-slate-300 text-slate-600 hover:bg-slate-100'}">${cat}</button>`
            ).join('');

            // 파싱 및 렌더링
            let blankIdCounter = 0;
            const container = document.getElementById('blank-container');
            container.innerHTML = '';
            parsedBlanks = [];
            blankStats.total = 0;

            blankData.forEach((item, index) => {
                let textHtml = item.text;
                // 정규식: [정답] 을 input으로 변환
                textHtml = textHtml.replace(/\[([^\]]+)\]/g, (match, answer) => {
                    const id = `blank-${blankIdCounter++}`;
                    parsedBlanks.push({ id, answer, solved: false });
                    blankStats.total++;
                    return `<input type="text" id="${id}" data-ans="${answer}" 
                            class="blank-input" 
                            autocomplete="off" autocorrect="off" spellcheck="false"
                            oninput="handleBlankInput(event, '${id}')"
                            onkeydown="handleBlankKey(event, '${id}')"
                            onblur="handleBlankBlur(event, '${id}')">`;
                });

                const card = document.createElement('div');
                card.className = `blank-card bg-white p-5 rounded-xl shadow-sm border border-slate-200 leading-relaxed text-slate-700 sm:text-lg`;
                card.setAttribute('data-category', item.category);
                card.innerHTML = `<span class="inline-block bg-slate-100 text-slate-500 text-xs font-bold px-2 py-1 rounded mb-2">${item.category}</span><br>${textHtml}`;
                container.appendChild(card);
            });
            updateProgressUI();
        }

        function filterBlanks(cat) {
            activeCategory = cat;
            // 버튼 스타일 업데이트
            document.querySelectorAll('#category-filters button').forEach(btn => {
                btn.className = `px-4 py-1.5 rounded-full text-sm font-semibold whitespace-nowrap transition-colors ${btn.innerText === cat ? 'bg-indigo-600 text-white' : 'bg-white border border-slate-300 text-slate-600 hover:bg-slate-100'}`;
            });

            // 카드 필터링
            document.querySelectorAll('.blank-card').forEach(card => {
                if (cat === '전체' || card.getAttribute('data-category') === cat) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function markBlankAsCorrect(inputEl, id) {
            const blankObj = parsedBlanks.find(b => b.id === id);
            if(blankObj.solved) return;
            blankObj.solved = true;
            blankStats.correct++;
            
            inputEl.value = blankObj.answer;
            inputEl.classList.add('correct');
            inputEl.disabled = true;
            
            // 다음 빈칸 포커스
            const currentIndex = parsedBlanks.findIndex(b => b.id === id);
            if (currentIndex < parsedBlanks.length - 1) {
                const nextId = parsedBlanks[currentIndex + 1].id;
                const nextEl = document.getElementById(nextId);
                if (nextEl && !nextEl.disabled) nextEl.focus();
            }
            updateProgressUI();
        }

        function markBlankAsWrong(inputEl, id) {
            const blankObj = parsedBlanks.find(b => b.id === id);
            if(blankObj.solved) return;
            blankObj.solved = true;
            blankStats.wrong++;

            const userAnswer = inputEl.value;
            inputEl.title = userAnswer ? `내가 쓴 오답: ${userAnswer}` : '미답변';
            inputEl.value = blankObj.answer;
            inputEl.classList.add('wrong-revealed');
            inputEl.disabled = true;
            updateProgressUI();
        }

        function handleBlankInput(e, id) {
            const el = e.target;
            const ans = el.getAttribute('data-ans');
            if (el.value.trim() === ans) {
                markBlankAsCorrect(el, id);
            }
        }

        function handleBlankKey(e, id) {
            if (e.key === 'Enter') {
                const el = e.target;
                const ans = el.getAttribute('data-ans');
                if (el.value.trim() === ans) {
                    markBlankAsCorrect(el, id);
                } else {
                    markBlankAsWrong(el, id);
                }
            }
        }

        function handleBlankBlur(e, id) {
            const el = e.target;
            if (el.value.trim() !== '' && !el.disabled) {
                const ans = el.getAttribute('data-ans');
                if (el.value.trim() !== ans) {
                    markBlankAsWrong(el, id);
                }
            }
        }

        function revealAllBlanks() {
            parsedBlanks.forEach(b => {
                if (!b.solved) {
                    const el = document.getElementById(b.id);
                    // 현재 활성화된 탭의 항목만 강제 노출
                    const card = el.closest('.blank-card');
                    if (card.style.display !== 'none') {
                        markBlankAsWrong(el, b.id);
                    }
                }
            });
        }

        // ==========================================
        // 4. 객관식 (MCQ) 로직
        // ==========================================
        function initMCQs() {
            const container = document.getElementById('mcq-container');
            container.innerHTML = '';
            
            mcqData.forEach((item, qIndex) => {
                const qDiv = document.createElement('div');
                qDiv.className = 'bg-white p-6 rounded-xl shadow-sm border border-slate-200';
                
                let optionsHtml = item.options.map((opt, oIndex) => `
                    <button id="opt-${qIndex}-${oIndex}" onclick="handleMCQClick(${qIndex}, ${oIndex})"
                            class="option-btn w-full text-left p-4 rounded-lg border-2 border-slate-100 bg-slate-50 text-slate-700 font-medium relative group">
                        <span class="inline-block w-6 h-6 rounded-full bg-slate-200 text-center leading-6 text-sm mr-2 text-slate-600 group-hover:bg-indigo-100 group-hover:text-indigo-600 transition-colors">${oIndex + 1}</span>
                        ${opt}
                    </button>
                `).join('');

                qDiv.innerHTML = `
                    <div class="flex items-start gap-3 mb-5">
                        <span class="bg-indigo-600 text-white font-bold px-3 py-1 rounded-lg shrink-0">Q${qIndex + 1}</span>
                        <h3 class="text-lg font-bold text-slate-800 pt-0.5 leading-snug">${item.q}</h3>
                    </div>
                    <div class="space-y-3 pl-0 sm:pl-12">
                        ${optionsHtml}
                    </div>
                    <div id="exp-${qIndex}" class="explanation-box ml-0 sm:ml-12 bg-indigo-50 border border-indigo-100 p-4 rounded-lg text-slate-700 text-sm leading-relaxed">
                        <strong class="text-indigo-700 block mb-1">💡 핵심 해설</strong>
                        ${item.exp}
                    </div>
                `;
                container.appendChild(qDiv);
            });
        }

        function handleMCQClick(qIndex, selectedIndex) {
            if (mcqState[qIndex].answered) return;
            
            mcqState[qIndex].answered = true;
            const qData = mcqData[qIndex];
            const isCorrect = (selectedIndex === qData.ans);

            if (isCorrect) {
                mcqStats.correct++;
            } else {
                mcqStats.wrong++;
            }

            // 스타일 적용
            qData.options.forEach((_, oIndex) => {
                const btn = document.getElementById(`opt-${qIndex}-${oIndex}`);
                btn.classList.add('option-disabled');
                btn.disabled = true;

                if (oIndex === qData.ans) {
                    // 진짜 정답은 초록색
                    btn.classList.remove('border-slate-100', 'bg-slate-50', 'text-slate-700');
                    btn.classList.add('option-correct');
                } else if (oIndex === selectedIndex && !isCorrect) {
                    // 내가 고른 오답은 빨간색
                    btn.classList.remove('border-slate-100', 'bg-slate-50', 'text-slate-700');
                    btn.classList.add('option-wrong');
                }
            });

            // 해설 노출
            document.getElementById(`exp-${qIndex}`).classList.add('show');
            updateProgressUI();
        }

        // ==========================================
        // 5. 초기화
        // ==========================================
        document.addEventListener('DOMContentLoaded', () => {
            initBlanks();
            initMCQs();
            switchTab('blank'); // 기본 탭
        });
    </script>
</body>
</html>
