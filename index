                </div>
                <!-- 빵꾸노트 컨테이너 -->
                <div id="blank-container" class="space-y-4"></div>
            </div>

            <!-- 탭 2: 객관식 -->
            <div id="view-mcq" class="hidden">
                <div id="mcq-container" class="space-y-6"></div>
            </div>
            
        </div>
    </main>

    <script>
